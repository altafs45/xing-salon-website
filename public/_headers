# HTML, sitemap.xml and robots.txt keep the host's default, which revalidates every time. A Cache-Control line here
# would be joined onto the rules below on Cloudflare Pages.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

