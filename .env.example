# Gift card & membership lead server (server/). Copy to `.env` (production, read by `npm start`) or
# `.env.local` (development, read by `npm run dev`) and fill in. Never commit the filled-in file.

# ---- Email (any SMTP inbox: Gmail with an app password, Zoho, Amazon SES SMTP…)
# Without SMTP_HOST, leads are still saved and the client still gets the WhatsApp button, but no email is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender shown on every email, e.g. "XING Salon <bookings@xingsalons.com>".
MAIL_FROM=

# XING's central inbox: gets every lead.
XING_EMAIL=

# Each salon's inbox: gets the leads for that salon. Leave blank to use the email in src/data/branches.ts.
# Google Search Console's HTML-tag token. Not needed if you verify by DNS (recommended).
VITE_GSC_VERIFICATION=

SALON_EMAIL_SARJAPUR=
SALON_EMAIL_HSR=
SALON_EMAIL_BROOKFIELD=

# Each salon's WhatsApp number, with country code (e.g. 919380812348). Leave blank to use src/data/branches.ts.
WA_NUMBER_SARJAPUR=
WA_NUMBER_HSR=
WA_NUMBER_BROOKFIELD=

# ---- WhatsApp Cloud API (off until approved templates exist; see server/adapters/whatsapp.ts)
WHATSAPP_API_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---- Online payment (off: "Pay online" shows "Launching soon"; see server/adapters/payment.ts)
# Turning it on also needs a rebuild, as the form reads it at build time.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Spam protection: at most 5 requests per IP and per phone number in this many minutes.
RATE_LIMIT_WINDOW_MIN=10

# ---- Optional
# PORT=8787
# LEADS_FILE=data/leads.json
# STATIC_DIR=dist
